<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="timesheet_tray_net.App"
             xmlns:local="using:timesheet_tray_net"
             xmlns:viewModels="clr-namespace:timesheet_tray_net.ViewModels"
             xmlns:converters="clr-namespace:timesheet_tray_net.Converters"
             RequestedThemeVariant="Default"
             x:DataType="viewModels:AppViewModel">
    
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

     <Design.DataContext>
         <viewModels:AppViewModel />
     </Design.DataContext>
    
    <Application.Resources>
        <converters:TimeConverter x:Key="TimeConverter"/>
    </Application.Resources>
             
    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
           
    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon
                Icon="/Assets/avalonia-logo.ico"
                ToolTipText="Timesheet"
                >
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem 
                            Header="{Binding CurrentStartTime, Converter={StaticResource TimeConverter}}"
                            IsVisible="{Binding IsStarted}"
                            IsEnabled="False"
                            />
                        <NativeMenuItemSeparator
                            IsVisible="{Binding IsStarted}"
                            />
                        <NativeMenuItem 
                            Header="{Binding StartText}" 
                            IsVisible="{Binding !IsStarted}"
                            Command="{Binding StartCommand}"
                            />
                        <NativeMenuItem 
                            Header="{Binding StopText}"
                            IsVisible="{Binding IsStarted}"
                            Command="{Binding StopCommand}"
                            />
                        <NativeMenuItem 
                            Header="{Binding DiscardText}"
                            IsVisible="{Binding IsStarted}"
                            Command="{Binding DiscardCommand}"
                        />
                        <NativeMenuItemSeparator/>
                        <NativeMenuItem 
                            Header="{Binding ExportText}" 
                            Command="{Binding ExportCommand}"
                            />
                        <NativeMenuItem 
                            Header="{Binding QuitText}" 
                            Command="{Binding QuitCommand}"
                            />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>