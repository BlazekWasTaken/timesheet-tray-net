<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="timesheet_tray_net.App"
             xmlns:local="using:timesheet_tray_net"
             xmlns:viewModels="clr-namespace:timesheet_tray_net.ViewModels"
             RequestedThemeVariant="Default"
             x:DataType="viewModels:AppViewModel">
    
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

     <Design.DataContext>
         <viewModels:AppViewModel />
     </Design.DataContext>
             
    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
           
    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon
                Icon="/Assets/avalonia-logo.ico"
                ToolTipText="Timesheet"
                >
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem 
                            Header="{Binding CurrentAction}" 
                            Command="{Binding StartStopCommand}"
                            />
                        <NativeMenuItemSeparator/>
                        <NativeMenuItem 
                            Header="{Binding QuitText}" 
                            Command="{Binding QuitCommand}"
                            />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>